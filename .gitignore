# ==============================================================================
# Qiling Framework Playbook .gitignore
# Excludes virtual environments, caches, downloaded binaries, and temporary files
# ==============================================================================

# Virtual Environments
.venv/
venv/
env/
ENV/
.env/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pytest / Coverage / Instrumentation Logs
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Qiling Generated Traces, Coverage & Dumps
*.drcov
*.bin
*.elf
*.exe
*.dll
*.dylib
*.log
*.tmp
triage_report.json
unpacked_text_section.bin
coverage_trace.drcov
rootfs_master.zip
rootfs-master/
rootfs/

# OS Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Directories
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Temporary / Scratch Dictionaries
scratch/
tmp/
temp/
